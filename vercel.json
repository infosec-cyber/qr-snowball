{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "public"
    },
    "api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "api/index.py"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/c/(.*)", "destination": "/index.html" },
    { "source": "/g/(.*)", "destination": "/index.html" },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
