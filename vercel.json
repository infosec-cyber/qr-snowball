{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/c/(.*)", "destination": "/index.html" },
    { "source": "/g/(.*)", "destination": "/index.html" }
  ]
}
